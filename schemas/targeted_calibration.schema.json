{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-offloading-new-arch.local/schemas/targeted-calibration-v1.json",
  "title": "Targeted annotator calibration package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calibration_version",
    "protocol_version",
    "language",
    "purpose",
    "answer_visibility",
    "pilot_content_reused",
    "is_ground_truth",
    "examples"
  ],
  "properties": {
    "calibration_version": {"const": "1.0.0"},
    "protocol_version": {"const": "1.2.0"},
    "language": {"const": "tr"},
    "purpose": {"type": "string", "minLength": 20},
    "answer_visibility": {"const": "worked_examples"},
    "pilot_content_reused": {"const": false},
    "is_ground_truth": {"const": false},
    "examples": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/example"}
    }
  },
  "$defs": {
    "field_name": {
      "enum": [
        "domain",
        "latency",
        "privacy",
        "execution_policy",
        "reliability",
        "accuracy",
        "energy_priority",
        "divisibility"
      ]
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "edge", "cloud"],
      "properties": {
        "device": {"enum": ["allowed", "forbidden", "unknown"]},
        "edge": {"enum": ["allowed", "forbidden", "unknown"]},
        "cloud": {"enum": ["allowed", "forbidden", "unknown"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "status", "explanation"],
      "properties": {
        "field": {"$ref": "#/$defs/field_name"},
        "status": {
          "enum": ["explicit", "not_stated", "ambiguous", "partial"]
        },
        "value": {
          "type": ["string", "number", "null"]
        },
        "numeric_value": {
          "type": ["number", "null"]
        },
        "metric": {
          "type": ["string", "null"]
        },
        "targets": {"$ref": "#/$defs/targets"},
        "explanation": {"type": "string", "minLength": 10}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_id", "text", "focus_fields", "decisions"],
      "properties": {
        "example_id": {
          "type": "string",
          "pattern": "^cal_tr_[0-9]{3}$"
        },
        "text": {"type": "string", "minLength": 20},
        "focus_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/field_name"}
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/decision"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-offloading-new-arch.local/schemas/human-annotation-record-v1.json",
  "title": "Independent human annotation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "protocol_version",
    "annotator_id",
    "task_id",
    "task_content_sha256",
    "started_at_utc",
    "submitted_at_utc",
    "annotation"
  ],
  "properties": {
    "record_version": {"const": "1.0.0"},
    "protocol_version": {"const": "1.0.0"},
    "annotator_id": {"enum": ["annotator_a", "annotator_b"]},
    "task_id": {"type": "string", "pattern": "^pilot_tr_[0-9]{3}$"},
    "task_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "submitted_at_utc": {"type": "string", "format": "date-time"},
    "annotation": {"type": "object"}
  }
}
